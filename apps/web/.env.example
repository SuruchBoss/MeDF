# ---------------------------------------------------------------------------
# MeDF configuration. Copy to `.env.local` for local development.
# ---------------------------------------------------------------------------

# Secret used to sign member session cookies. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MEDF_SESSION_SECRET=

# Where members, documents and uploaded files are stored.
# Defaults to `<repo>/.medf-data` in development and to the OS per-user
# application-data folder in the packaged desktop build.
# MEDF_DATA_DIR=/var/lib/medf

# Public base URL, used for Stripe redirects and e-mail links.
MEDF_APP_URL=http://localhost:4173

# Set to "1" to allow the built-in checkout simulator (no card required).
# It is enabled automatically when Stripe is not configured.
MEDF_BILLING_SANDBOX=1

# --- Stripe (optional) -----------------------------------------------------
# When STRIPE_SECRET_KEY is present, real Stripe Checkout is used instead of
# the sandbox. Create one recurring price per paid plan and paste the ids.
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_PRO_MONTHLY=price_xxx
# STRIPE_PRICE_PRO_YEARLY=price_xxx
# STRIPE_PRICE_TEAM_MONTHLY=price_xxx
# STRIPE_PRICE_TEAM_YEARLY=price_xxx

# E-mail address that is promoted to the admin role on registration.
# MEDF_ADMIN_EMAIL=you@example.com

# --- Paid add-on module (open-core model, see docs/OPEN_CORE.md) ------------
# Path to the private module that implements the paid features. Leave unset to
# run the pure open-source build, where those features report as not installed.
# MEDF_PRO_MODULE=/opt/medf-pro/index.js
#
# Set to "1" to ignore any installed module and force the open-source build.
# MEDF_PRO_DISABLE=0
