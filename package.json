{
  "name": "medf",
  "version": "1.0.0",
  "private": true,
  "description": "MeDF \u2014 PDF editor with drag & drop overlay editing, members and subscriptions",
  "workspaces": [
    "apps/web",
    "apps/demo",
    "desktop"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace medf-web",
    "build": "npm run build --workspace medf-web",
    "start": "npm run start --workspace medf-web",
    "lint": "npm run lint --workspace medf-web",
    "typecheck": "npm run typecheck --workspace medf-web",
    "desktop:dev": "npm run dev --workspace medf-desktop",
    "desktop:build": "npm run build --workspace medf-desktop",
    "dist:win": "npm run dist:win --workspace medf-desktop",
    "dist:win:portable": "npm run dist:win:portable --workspace medf-desktop",
    "test": "npm run guard:private && npm run test:unit && npm run test:api && npm run test:ui && npm run test:demo",
    "test:api": "node apps/web/scripts/smoke-test.mjs",
    "test:ui": "node apps/web/scripts/ui-test.mjs",
    "test:standalone": "node apps/web/scripts/verify-standalone.mjs",
    "test:desktop": "node desktop/scripts/verify-shell.mjs",
    "guard:private": "node scripts/guard-private.mjs",
    "setup:hooks": "node scripts/install-hooks.mjs",
    "pro:scaffold": "node scripts/scaffold-pro.mjs",
    "demo:dev": "npm run dev --workspace medf-demo",
    "demo:build": "npm run build --workspace medf-demo",
    "test:demo": "node apps/web/scripts/demo-test.mjs",
    "test:static": "node apps/demo/scripts/static-test.mjs",
    "test:unit": "npm run test:unit --workspace medf-web"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "http-server": "^14.1.1"
  }
}
